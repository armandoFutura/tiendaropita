---
import BaseLayout from '../layouts/BaseLayout.astro';
import { productos, categorias } from '../lib/productos-data';
import ProductGrid from '../components/ProductGrid';
---

<BaseLayout title="Inicio">
  <div class="bg-gradient-to-br from-pink-50 via-white to-purple-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
      <div class="text-center max-w-2xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-secondary-900 mb-4">
          Ropa Infantil <span class="text-primary-500">Unicolor</span>
        </h1>
        <p class="text-lg text-secondary-600 mb-8">
          Ropa cómoda, moderna y de calidad para tus hijos. Precios justos con descuentos por volumen.
        </p>
        <a href="/catalogo" class="btn-primary text-lg inline-block px-8">
          Ver Catálogo
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="text-center p-6 bg-secondary-50 rounded-2xl">
        <p class="text-3xl mb-2">🧸</p>
        <p class="font-semibold">Ropa de Calidad</p>
        <p class="text-sm text-secondary-500">Algodón premium</p>
      </div>
      <div class="text-center p-6 bg-secondary-50 rounded-2xl">
        <p class="text-3xl mb-2">📦</p>
        <p class="font-semibold">Descuentos Mayorista</p>
        <p class="text-sm text-secondary-500">3+ unidades mismo modelo</p>
      </div>
      <div class="text-center p-6 bg-secondary-50 rounded-2xl">
        <p class="text-3xl mb-2">🚚</p>
        <p class="font-semibold">Envío a Todo Chile</p>
        <p class="text-sm text-secondary-500">Por BlueExpress</p>
      </div>
      <div class="text-center p-6 bg-secondary-50 rounded-2xl">
        <p class="text-3xl mb-2">💬</p>
        <p class="font-semibold">Compra por WhatsApp</p>
        <p class="text-sm text-secondary-500">Fácil y rápido</p>
      </div>
    </div>

    <h2 class="text-2xl font-bold mb-8">Productos Destacados</h2>
    <ProductGrid productos={productos.slice(0, 4)} categoria="todas" categorias={categorias} />
    <div class="text-center mt-8">
      <a href="/catalogo" class="btn-outline">Ver todos los productos →</a>
    </div>
  </div>
</BaseLayout>
